SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_NAME=KnovaLand

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=knova
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Fallback for local dev without Postgres (will use SQLite if DB_ENGINE not set to postgres)
# Just comment DB_ENGINE above

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Email (Yandex SMTP). Если EMAIL_HOST_USER/PASSWORD пусты — письма идут в консоль.
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@knova.local

# Требовать подтверждение email для входа (True/False)
EMAIL_VERIFICATION_REQUIRED=False

